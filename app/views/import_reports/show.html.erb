<% content_for :title, "Import ##{@import_report.id}" %>

<div class="page">
  <%= render "shared/page_header", title: "Import ##{@import_report.id}", subtitle: @import_report.import_type.humanize %>
  <p class="back-link"><%= link_to "Back to import reports", import_reports_path %></p>

  <div class="grid-2" id="<%= dom_id @import_report %>">
    <section class="surface" aria-labelledby="import-errors">
      <div class="surface-head"><h2 id="import-errors">Errors</h2><span class="muted text-sm"><%= pluralize(@import_errors.size, "error") %></span></div>
      <% if @import_errors.any? %>
        <rfg-table>
          <table class="data-table">
            <caption class="sr-only">Errors in import #<%= @import_report.id %></caption>
            <thead><tr><th scope="col">Problem</th><th scope="col">File</th><th scope="col">Topic</th></tr></thead>
            <tbody>
              <% @import_errors.each do |error| %>
                <tr>
                  <th scope="row">
                    <span class="font-semibold"><%= error.error_type.humanize %></span>
                    <% if error.error_message.present? %><div class="row-meta"><%= error.error_message %></div><% end %>
                  </th>
                  <td><% if error.file_name.present? %><code class="uid"><%= error.file_name %></code><% else %><span class="muted">—</span><% end %></td>
                  <td><% if error.topic_id && (topic = Topic.find_by(id: error.topic_id)) %><%= link_to topic.title, topic_path(topic) %><% else %><span class="muted">—</span><% end %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </rfg-table>
      <% else %>
        <div class="surface-body"><p class="muted m-0">No errors.</p></div>
      <% end %>
    </section>

    <div class="stack">
      <section class="surface" aria-labelledby="import-status">
        <div class="surface-head"><h2 id="import-status">Status</h2><%= import_status_pill(@import_report) %></div>
        <div class="surface-body">
          <dl class="details details--stacked">
            <dt>Started</dt><dd><%= import_time(@import_report.started_at, "Not started") %></dd>
            <dt>Finished</dt><dd><%= import_time(@import_report.completed_at, "Not finished") %></dd>
            <dt>Created</dt><dd><%= import_time(@import_report.created_at, "") %></dd>
          </dl>
        </div>
      </section>

      <% if @import_report.summary_stats.present? %>
        <section class="surface" aria-labelledby="import-summary">
          <div class="surface-head"><h2 id="import-summary">Summary</h2></div>
          <div class="surface-body">
            <dl class="details details--stacked">
              <% @import_report.summary_stats.each do |key, value| %>
                <dt><%= key.to_s.humanize %></dt>
                <dd><%= value.is_a?(Hash) || value.is_a?(Array) ? tag.code(value.to_json, class: "uid") : value %></dd>
              <% end %>
            </dl>
          </div>
        </section>
      <% end %>
    </div>
  </div>
</div>
