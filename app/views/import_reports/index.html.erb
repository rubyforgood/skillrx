<% content_for :title, "Import reports" %>

<div class="page">
  <%= render "shared/page_header", title: "Import reports" %>

  <%= form_with url: import_reports_path, method: :get, local: true, html: { role: "search", "aria-label": "Import reports" }, data: { controller: "search", search_target: "search" } do |f| %>
    <rfg-filter-bar>
      <div slot="fields">
        <%= f.label :status, "Status", class: "form-label" %>
        <%= f.select :status, options_for_select([["Any status", ""]] + @available_statuses.map { |s| [s.humanize, s] }, params[:status]),
              {}, class: "form-select", data: { action: "change->search#submit" } %>
      </div>
      <a slot="actions" class="button button-ghost" href="<%= import_reports_path %>">Clear filters</a>
    </rfg-filter-bar>
  <% end %>

  <%= turbo_frame_tag "reports-list" do %>
    <div class="surface">
      <rfg-table>
        <table class="data-table">
          <caption class="sr-only">Import reports</caption>
          <thead>
            <tr>
              <th scope="col">Import</th>
              <th scope="col">Status</th>
              <th scope="col" class="numeric">Errors</th>
              <th scope="col">Started</th>
              <th scope="col">Finished</th>
            </tr>
          </thead>
          <tbody>
            <% @import_reports.each do |report| %>
              <tr>
                <th scope="row">
                  <%= link_to "Import ##{report.id}", report, class: "row-title", data: { turbo_frame: "_top" } %>
                  <div class="row-meta"><%= report.import_type.humanize %></div>
                </th>
                <td><%= import_status_pill(report) %></td>
                <td class="numeric"><% n = report.import_errors.to_a.length %><%= n.positive? ? n : tag.span("0", class: "muted") %></td>
                <td class="whitespace-nowrap"><%= import_time(report.started_at, "Not started") %></td>
                <td class="whitespace-nowrap"><%= import_time(report.completed_at, "Not finished") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </rfg-table>
      <% if @import_reports.none? %>
        <div class="empty"><p class="empty-title">No import reports<%= " with this status" if params[:status].present? %></p><p>Reports appear here after a bulk import runs.</p></div>
      <% end %>
      <div class="table-foot">
        <p class="table-count"><%= pluralize(@import_reports.size, "report") %></p>
        <%= render "shared/pagination", pagy: @pagy if @pagy.pages > 1 %>
      </div>
    </div>
  <% end %>
</div>
