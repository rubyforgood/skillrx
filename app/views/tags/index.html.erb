<% content_for :title, "Tags" %>

<div class="page">
  <%= render "shared/page_header", title: "Tags" %>

  <%= form_for :search, url: tags_path, method: :get, html: { role: "search", "aria-label": "Tags" },
        data: { controller: "search", search_target: "search", turbo_frame: "tag-list", turbo_action: "advance" } do |f| %>
    <% current = (params[:search]&.permit(:name, :order)&.to_h || {}).with_indifferent_access %>
    <rfg-filter-bar>
      <div slot="search">
        <%= f.label :name, "Search", class: "form-label" %>
        <%= f.search_field :name, value: current[:name], placeholder: "Tag name", class: "form-input", data: { action: "input->search#submit" } %>
      </div>
      <div slot="fields">
        <%= f.label :order, "Sort", class: "form-label" %>
        <%= f.select :order, options_for_select([["Name", "name"], ["Most recently added", "desc"], ["Least recently added", "asc"],
              ["Highest number of taggings", "most_tagged"], ["Lowest number of taggings", "least_tagged"]], current[:order].to_s),
              {}, class: "form-select", data: { action: "change->search#submit" } %>
      </div>
      <a slot="actions" class="button button-ghost" href="<%= tags_path %>">Clear filters</a>
    </rfg-filter-bar>
  <% end %>

  <%= turbo_frame_tag "tag-list" do %>
    <div class="surface">
      <rfg-table>
        <table class="data-table">
          <caption class="sr-only">Tags</caption>
          <thead>
            <tr>
              <th scope="col">Tag</th>
              <th scope="col">Cognates</th>
              <th scope="col" class="numeric">Topics</th>
              <th scope="col" class="actions-col"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <%= render "list" %>
        </table>
      </rfg-table>
      <% if @tags.none? %>
        <div class="empty"><p class="empty-title">No tags match</p><p>Try another search, or <%= link_to "clear it", tags_path, data: { turbo_frame: "_top" } %>.</p></div>
      <% end %>
      <div class="table-foot">
        <p class="table-count"><% if @pagy.count.zero? %>No tags<% else %>Showing <strong><%= @pagy.from %>–<%= @pagy.to %></strong> of <strong><%= @pagy.count %></strong> <%= "tag".pluralize(@pagy.count) %><% end %></p>
        <%= render "shared/pagination", pagy: @pagy %>
      </div>
    </div>
  <% end %>
</div>
