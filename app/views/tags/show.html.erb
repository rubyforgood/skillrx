<% content_for :title, @tag.name %>

<div class="page">
  <%= render "shared/page_header", title: @tag.name do %>
    <div id="<%= "delete_tag_#{@tag.id}" %>" class="contents">
      <%= button_to "Delete", @tag, method: :delete, class: "button button-ghost-danger", form_class: "contents" %>
    </div>
    <%= link_to "Edit", edit_tag_path(@tag), class: "button button-secondary", data: { turbo: false } %>
  <% end %>
  <p class="back-link"><%= link_to "Back to tags", tags_path %></p>

  <div class="grid-2">
    <%= render "taggings" %>

    <section class="surface" aria-labelledby="tag-details">
      <div class="surface-head"><h2 id="tag-details">Details</h2></div>
      <div class="surface-body">
        <dl class="details details--stacked">
          <dt>Used on</dt><dd><%= pluralize(@tag.taggings_count, "topic") %></dd>
          <dt>Cognates</dt>
          <dd>
            <% if @tag.cognates_tags.any? %>
              <ul class="chips"><% @tag.cognates_tags.each do |cognate| %><li class="chip"><%= link_to cognate.name, tag_path(cognate), data: { turbo: false } %></li><% end %></ul>
              <p class="form-help-text mt-2 mb-0">Tagging a topic with this tag also adds these.</p>
            <% else %><span class="muted">None</span><% end %>
          </dd>
        </dl>
      </div>
    </section>
  </div>
</div>
