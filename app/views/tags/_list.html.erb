<tbody>
  <% @tags.each do |tag| %>
    <tr>
      <th scope="row"><%= link_to tag.name, tag, class: "row-title", data: { turbo: false } %></th>
      <td>
        <% if tag.cognates_tags.any? %>
          <ul class="chips"><% tag.cognates_tags.each do |cognate| %><li class="chip"><%= link_to cognate.name, tag_path(cognate), data: { turbo: false } %></li><% end %></ul>
        <% else %><span class="muted">None</span><% end %>
      </td>
      <td class="numeric"><%= tag.taggings_count %></td>
      <td class="actions-col">
        <%= link_to "Edit", edit_tag_path(tag), class: "button button-ghost button-sm", aria: { label: "Edit #{tag.name}" }, data: { turbo: false } %>
      </td>
    </tr>
  <% end %>
</tbody>
