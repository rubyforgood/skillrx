<%= form_with(model: tag, local: true, html: { class: "surface", novalidate: true }) do |form| %>
  <div class="form-card">
    <%= render "shared/errors", errors: tag.errors.full_messages, resource_name: "tag" %>

    <%= form_field form, :name, label: "Name", required: true, hint: "For example, malaria or hand hygiene." do %>
      <%= form.text_field :name, class: "form-input" %>
    <% end %>

    <div data-controller="select-tags">
      <%= form_field form, :cognates_list, label: "Cognates", optional: true, for_id: "tag_cognates_list",
            hint: "Tags that mean the same thing, such as translations. Tagging a topic with one adds the others. Type to find a tag, or press Enter to add a new one." do %>
        <%= form.select :cognates_list, options_from_collection_for_select(tag.all_available_tags, :name, :name, tag.cognates_list),
              { include_blank: true }, multiple: true, placeholder: "Add cognates", data: { "allow-clear": "true", "select-tags-target": "tagList" } %>
      <% end %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit tag.persisted? ? "Save tag" : "Add tag", class: "button button-primary" %>
    <%= link_to "Cancel", tag.persisted? ? tag_path(tag) : tags_path, class: "button button-ghost" %>
  </div>
<% end %>
