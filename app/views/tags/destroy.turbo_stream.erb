<%# Shown in place of the Delete button: the app confirms, not the browser. %>
<%= turbo_stream.update "delete_tag_#{@tag.id}" do %>
  <div class="inline-confirm" role="alert">
    <p><strong>Delete this tag?</strong> It's removed from <%= pluralize(@tag.taggings_count, "topic") %>. This can't be undone.</p>
    <%= button_to "Delete tag", tag_path(@tag, confirmed: true), method: :delete, class: "button button-danger", form_class: "contents" %>
    <%= link_to "Cancel", tag_path(@tag), data: { turbo_frame: "_top" }, class: "button button-ghost" %>
  </div>
<% end %>
