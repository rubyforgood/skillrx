<section class="surface" aria-labelledby="tag-topics">
  <div class="surface-head"><h2 id="tag-topics">Topics with this tag</h2><span class="muted text-sm"><%= pluralize(@tag.taggings_count, "topic") %></span></div>
  <% if @tag.taggings.any? %>
    <ul class="people">
      <% @tag.taggings.includes(:taggable).each do |tagging| %>
        <li><%= link_to tagging.taggable.title, url_for(tagging.taggable) %></li>
      <% end %>
    </ul>
  <% else %>
    <div class="surface-body"><p class="muted m-0">No topics use this tag yet.</p></div>
  <% end %>
</section>
