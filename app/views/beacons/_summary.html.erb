<%# Counts by status (decided 2026-11-25): what beacons report, with no "online" threshold invented. %>
<% counts = @beacons.group_by { |b| beacon_status_key(b) }.transform_values(&:size) %>
<dl class="stats" aria-label="Beacons by status">
  <div class="stat"><dt>Total</dt><dd data-stat="total"><%= @beacons.size %></dd></div>
  <div class="stat"><dt>Synced</dt><dd data-stat="synced"><%= counts["synced"].to_i %></dd></div>
  <div class="stat"><dt>Needs update</dt><dd data-stat="outdated"><%= counts["outdated"].to_i %></dd></div>
  <div class="stat stat--alert"><dt>Error</dt><dd data-stat="error"><%= counts["error"].to_i %></dd></div>
  <div class="stat"><dt>Never synced</dt><dd data-stat="never"><%= counts[nil].to_i %></dd></div>
  <div class="stat"><dt>Revoked</dt><dd data-stat="revoked"><%= counts["revoked"].to_i %></dd></div>
</dl>
