<% content_for :title, @beacon.name %>

<div class="page">
  <%= render "shared/page_header", title: @beacon.name do %>
    <%= link_to "Edit", edit_beacon_path(@beacon), class: "button button-primary", data: { turbo: false } %>
  <% end %>
  <p class="back-link"><%= link_to "Back to beacons", beacons_path %></p>

  <% if params[:api_key] %>
    <%# Shown once, straight after provisioning or regenerating: the full key is never stored. %>
    <section class="new-key" aria-labelledby="new-key-heading" data-controller="beacons">
      <h2 id="new-key-heading">Save this API key now</h2>
      <p>Copy it into the beacon's settings. For security, SkillRx shows the full key only this once. If it's lost, regenerate a new one.</p>
      <div class="new-key-row">
        <code data-beacons-target="beaconApiKey"><%= params[:api_key] %></code>
        <button type="button" class="button button-secondary" data-beacons-target="button" data-action="click->beacons#copyApiKey">Copy key</button>
      </div>
    </section>
  <% end %>

  <div class="grid-2">
    <div class="stack">
      <section class="surface" aria-labelledby="beacon-status">
        <div class="surface-head"><h2 id="beacon-status">Status</h2><%= beacon_status_pill(@beacon) %></div>
        <div class="surface-body">
          <dl class="details">
            <dt>Last seen</dt><dd><%= time_ago_or_never(@beacon.last_seen_at) %></dd>
            <dt>Last synced</dt><dd><%= time_ago_or_never(@beacon.last_sync_at) %></dd>
            <dt>Content version</dt>
            <dd><%= @beacon.reported_manifest_version.presence || "None reported" %> <span class="muted">(latest is <%= @beacon.manifest_version %>)</span></dd>
            <% if @beacon.last_sync_error.present? %>
              <dt>Last error</dt><dd class="text-danger"><%= @beacon.last_sync_error %></dd>
            <% end %>
          </dl>
        </div>
      </section>

      <section class="surface" aria-labelledby="beacon-content">
        <div class="surface-head"><h2 id="beacon-content">Content on this beacon</h2>
          <span class="muted text-sm"><%= pluralize(@beacon.document_count, "topic") %>, <%= pluralize(@beacon.file_count, "file") %></span></div>
        <div class="surface-body">
          <dl class="details">
            <dt>Language</dt><dd><%= @beacon.language_name.upcase_first %></dd>
            <dt>Region</dt><dd><%= @beacon.region_name %></dd>
            <dt>Providers</dt>
            <dd>
              <% if @beacon.providers.any? %>
                <ul class="chips"><% @beacon.providers.each do |provider| %><li class="chip"><%= provider.name %></li><% end %></ul>
              <% else %>All providers<% end %>
            </dd>
            <dt>Topics</dt>
            <dd>
              <% if @beacon.topics.any? %>
                <ul class="chips"><% @beacon.topics.each do |topic| %><li class="chip"><%= link_to topic.title, topic_path(topic) %></li><% end %></ul>
              <% else %>All topics in its language and region<% end %>
            </dd>
          </dl>
        </div>
      </section>
    </div>

    <div class="stack">
      <section class="surface" aria-labelledby="beacon-key">
        <div class="surface-head"><h2 id="beacon-key">API key</h2></div>
        <div class="surface-body stack">
          <dl class="details details--stacked">
            <dt>Key</dt><dd class="font-mono"><%= @beacon.api_key_prefix %>…</dd>
            <% if @beacon.revoked? %>
              <dt>Revoked</dt><dd><%= @beacon.revoked_at.strftime("%b %-d, %Y") %></dd>
            <% end %>
          </dl>
          <div class="button-row">
            <%= button_to "Regenerate key", regenerate_key_beacon_path(@beacon), method: :post, class: "button button-secondary", form_class: "contents",
                  data: { turbo_confirm: "The current key stops working at once. The beacon won't sync until it has the new key.", confirm_button: "Regenerate key" } %>
            <% unless @beacon.revoked? %>
              <%= button_to "Revoke key", revoke_key_beacon_path(@beacon), method: :post, class: "button button-ghost text-danger", form_class: "contents",
                    data: { turbo_confirm: "The beacon stops syncing at once and can't get new content until you regenerate a key.", confirm_button: "Revoke key" } %>
            <% end %>
          </div>
        </div>
      </section>

      <section class="surface" aria-labelledby="beacon-record">
        <div class="surface-head"><h2 id="beacon-record">Record</h2></div>
        <div class="surface-body">
          <dl class="details details--stacked">
            <dt>Provisioned</dt><dd><%= @beacon.created_at.strftime("%b %-d, %Y at %-l:%M %p") %></dd>
            <dt>Last updated</dt><dd><%= @beacon.updated_at.strftime("%b %-d, %Y at %-l:%M %p") %></dd>
            <dt>ID</dt><dd><%= @beacon.id %></dd>
          </dl>
        </div>
      </section>
    </div>
  </div>
</div>
