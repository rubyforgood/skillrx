<div class="surface">
  <rfg-table>
    <table class="data-table">
      <caption class="sr-only">Beacons</caption>
      <thead>
        <tr>
          <th scope="col">Beacon</th>
          <th scope="col">Status</th>
          <th scope="col" class="numeric">Content version</th>
          <th scope="col">Last seen</th>
          <th scope="col">Last synced</th>
          <th scope="col" class="actions-col"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% if @beacons.any? %>
          <% @beacons.each do |beacon| %>
            <tr>
              <th scope="row">
                <%= link_to beacon.name, beacon_path(beacon), class: "row-title" %>
                <div class="row-meta"><%= beacon.region_name %> · <%= beacon.language_name.upcase_first %></div>
              </th>
              <td><%= beacon_status_pill(beacon) %></td>
              <td class="numeric">
                <%= beacon.reported_manifest_version.presence || "—" %>
                <span class="muted">of <%= beacon.manifest_version %></span>
              </td>
              <td class="whitespace-nowrap"><%= time_ago_or_never(beacon.last_seen_at) %></td>
              <td class="whitespace-nowrap"><%= time_ago_or_never(beacon.last_sync_at) %></td>
              <td class="actions-col">
                <%= link_to "Edit", edit_beacon_path(beacon), class: "button button-ghost button-sm", aria: { label: "Edit #{beacon.name}" }, data: { turbo: false } %>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="6" class="empty">
              <p class="empty-title">No beacons provisioned yet</p>
              <p>Provision one to start serving content in the field.</p>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </rfg-table>
</div>
