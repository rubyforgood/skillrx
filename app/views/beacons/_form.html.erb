<%= form_with model: beacon, local: true, html: { class: "surface", novalidate: true },
      data: { controller: "beacon-form", beacon_form_filter_url_value: filter_options_beacons_path } do |form| %>
  <div class="form-card">
    <%= render "shared/errors", errors: beacon.errors.full_messages, resource_name: "beacon" %>

    <section class="form-section" aria-labelledby="beacon-basics">
      <h2 id="beacon-basics">Beacon</h2>
      <%= form_field form, :name, label: "Name", required: true, hint: "Use its location, for example Kampala central clinic." do %>
        <%= form.text_field :name, class: "form-input" %>
      <% end %>
    </section>

    <section class="form-section" aria-labelledby="beacon-content-heading">
      <h2 id="beacon-content-heading">Content</h2>
      <p class="form-help-text -mt-3">The beacon gets only the topics you choose here. Choosing a language and region narrows the lists.</p>

      <div class="form-grid">
        <%= form_field form, :language_id, label: "Language", required: true do %>
          <%= form.select :language_id, options_from_collection_for_select(@languages, :id, ->(l) { l.name.upcase_first }, beacon.language_id),
                { include_blank: "Choose a language" }, class: "form-select",
                data: { action: "change->beacon-form#fetchOptions", "beacon-form-target": "languageSelect" } %>
        <% end %>

        <%= form_field form, :region_id, label: "Region", required: true do %>
          <%= form.select :region_id, options_from_collection_for_select(@regions, :id, :name, beacon.region_id),
                { include_blank: "Choose a region" }, class: "form-select",
                data: { action: "change->beacon-form#fetchOptions", "beacon-form-target": "regionSelect" } %>
        <% end %>
      </div>

      <div data-controller="select-tags" data-select-tags-dropdown-parent-value="body">
        <%= form_field form, :provider_ids, label: "Providers", optional: true, hint: "Only providers working in the beacon's region are listed." do %>
          <%= form.select :provider_ids, options_from_collection_for_select(@providers, :id, :name, beacon.provider_ids),
                { include_blank: true }, multiple: true, placeholder: "Choose providers",
                data: { "allow-new": "false", "allow-clear": "true", "select-tags-target": "tagList", "dropdown-parent": "body", "beacon-form-target": "providersSelect" } %>
        <% end %>
      </div>

      <div data-controller="select-tags" data-select-tags-dropdown-parent-value="body">
        <%= form_field form, :topic_ids, label: "Topics", optional: true, hint: "Only active topics in the beacon's language are listed. With none chosen, the beacon has no content." do %>
          <%= form.select :topic_ids, options_from_collection_for_select(@topics, :id, :title, beacon.topic_ids),
                { include_blank: true }, multiple: true, placeholder: "Choose topics",
                data: { "allow-new": "false", "allow-clear": "true", "select-tags-target": "tagList", "dropdown-parent": "body", "beacon-form-target": "topicsSelect" } %>
        <% end %>
      </div>
    </section>
  </div>

  <div class="form-actions">
    <%= form.submit beacon.persisted? ? "Save beacon" : "Provision beacon", class: "button button-primary" %>
    <%= link_to "Cancel", beacon.persisted? ? beacon_path(beacon) : beacons_path, class: "button button-ghost" %>
    <% if beacon.persisted? %>
      <span class="form-meta">Last updated <%= beacon.updated_at.strftime("%b %-d, %Y at %-l:%M %p") %></span>
    <% end %>
  </div>
<% end %>
