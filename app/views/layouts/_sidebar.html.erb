<%# The app's navigation rail (docs/design/design.md, "App shell"). Text only, no icons: with three
    top-level entries, hierarchy is shown by weight and indent. Administration starts open, as
    previewed: it is the only group, and its seven items fit without scrolling. %>
<div class="shell-rail-inner">
  <div class="shell-logo">
    <%= link_to shell_path(:root), class: "shell-logo-link" do %>
      <%= image_tag("skill.svg", alt: "SkillRx home", class: "h-9") %>
    <% end %>
  </div>

  <nav class="shell-nav" aria-label="Main">
    <ul class="shell-nav-list" role="list">
      <li>
        <%= nav_link_to shell_path(:topics) do %>
          <span>Topics</span>
        <% end %>
      </li>

      <% if Current.user.is_admin? %>
        <li>
          <%= nav_link_to shell_path(:beacons) do %>
            <span>Beacons</span>
          <% end %>
        </li>

        <li>
          <button type="button" class="shell-nav-group" aria-expanded="true" aria-controls="nav-administration"
                  data-action="shell#toggleGroup">
            <span>Administration</span>
            <svg class="shell-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <ul id="nav-administration" class="shell-nav-sublist" role="list">
            <li><%= nav_link_to "Providers", shell_path(:providers) %></li>
            <li><%= nav_link_to "Regions", shell_path(:regions) %></li>
            <li><%= nav_link_to "Languages", shell_path(:languages) %></li>
            <li><%= nav_link_to "Tags", shell_path(:tags) %></li>
            <li><%= nav_link_to "Users", shell_path(:users) %></li>
            <li><%= nav_link_to "Import reports", shell_path(:import_reports) %></li>
            <%# Jobs (Mission Control) renders inside this shell (layouts/mission_control/jobs), so it
                opens in place like every other page. A plain "/jobs": inside the engine, its route
                helpers add ?server_id=…, which would stop Jobs from showing as current. %>
            <li><%= nav_link_to "Jobs", "/jobs" %></li>
          </ul>
        </li>
      <% end %>
    </ul>
  </nav>

  <%# The account (docs/design/design.md, "App shell"): the whole row is the menu's trigger, as in
      Slack, Discord and VS Code, with an up-down chevron for "opens a menu". The menu names the
      account first, then its actions. The avatar is aria-hidden: the button already says the email.
      Plain HTML in the trigger, not helpers: in development Herb wraps ERB output in a <span>, and
      the trigger must be <rfg-menu>'s direct child. docs/design/decisions.md, 2026-11-27. %>
  <rfg-menu label="Account" placement="top-start" class="shell-account">
    <button slot="trigger" type="button" class="shell-account-trigger">
      <rfg-avatar name="<%= Current.user.email %>" aria-hidden="true"></rfg-avatar>
      <span class="shell-account-who">
        <span class="shell-account-email"><%= Current.user.email %></span>
        <span class="shell-account-role"><%= Current.user.is_admin? ? "Administrator" : "Contributor" %></span>
      </span>
      <svg class="shell-account-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m7 15 5 5 5-5"/><path d="m7 9 5-5 5 5"/></svg>
    </button>
    <div class="shell-account-menu-head">
      <span class="shell-account-email"><%= Current.user.email %></span>
      <span class="shell-account-role"><%= Current.user.is_admin? ? "Administrator" : "Contributor" %></span>
    </div>
    <%= form_with url: shell_path(:session), method: :delete do %>
      <button type="submit" role="menuitem">Sign out</button>
    <% end %>
  </rfg-menu>
</div>
