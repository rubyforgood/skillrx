<h1>Choose a new password</h1>
<p class="auth-lede">Up to 72 characters.</p>

<%= render "shared/auth_messages" %>

<%= form_with url: password_path(params[:token]), method: :put, class: "auth-form" do |form| %>
  <rfg-field label="New password">
    <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password",
                                       maxlength: 72, class: "form-input" %>
  </rfg-field>

  <rfg-field label="Confirm new password">
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
                                                    maxlength: 72, class: "form-input" %>
  </rfg-field>

  <rfg-button variant="primary" type="submit">Save password</rfg-button>

  <p class="auth-help">
    Remembered it? <%= link_to "Sign in", new_session_path %>.
    Need help? <a href="mailto:contact@skillrx.org">Contact us</a>
  </p>
<% end %>
