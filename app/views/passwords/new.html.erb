<h1>Reset your password</h1>
<p class="auth-lede">Enter your email address and we'll send you a link to reset your password.</p>

<%= render "shared/auth_messages" %>

<%= form_with url: passwords_path, local: true, class: "auth-form" do |form| %>
  <rfg-field label="Email address">
    <%= form.email_field :email, required: true, autofocus: true, autocomplete: "email",
                                 value: params[:email], class: "form-input" %>
  </rfg-field>

  <rfg-button variant="primary" type="submit">Send reset link</rfg-button>

  <p class="auth-help">
    Remembered it? <%= link_to "Sign in", new_session_path %>.
    Need help? <a href="mailto:contact@skillrx.org">Contact us</a>
  </p>
<% end %>
