<%# Messages after an action, at the top of the page (design system: callouts). Problems are alerts,
    announced at once; anything else is a polite status. %>
<% flash.each do |name, msg| %>
  <% next unless msg.is_a?(String) && msg.present? %>
  <% tone = { "notice" => "success", "success" => "success", "alert" => "danger", "error" => "danger", "warning" => "warning" }.fetch(name.to_s, "info") %>
  <rfg-callout tone="<%= tone %>" class="flash"><%= msg %></rfg-callout>
<% end %>
