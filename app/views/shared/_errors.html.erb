<%# The error summary at the top of a form (design system design.md, "Forms: required fields and
    validation errors"): announced at once, listing every problem; each field also shows its own. %>
<% if errors.any? %>
  <div class="error-summary" role="alert" tabindex="-1">
    <h2>Fix <%= errors.count == 1 ? "this problem" : "these #{errors.count} problems" %> to save the <%= resource_name.underscore.humanize(capitalize: false) %></h2>
    <ul>
      <% errors.each do |error| %>
        <li><%= error %></li>
      <% end %>
    </ul>
  </div>
<% end %>
