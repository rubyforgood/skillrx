<h1>Sign in</h1>
<p class="auth-lede">to manage SkillRx topics and beacons</p>

<%= render "shared/auth_messages" %>

<%= form_with url: session_path, local: true, class: "auth-form", html: { novalidate: true } do |form| %>
  <rfg-field label="Email address">
    <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username",
                                 value: params[:email], class: "form-input" %>
  </rfg-field>

  <rfg-field label="Password">
    <%= form.password_field :password, required: true, autocomplete: "current-password",
                                       maxlength: 72, class: "form-input" %>
  </rfg-field>

  <div class="auth-row"><%= link_to "Forgot your password?", new_password_path %></div>

  <rfg-button variant="primary" type="submit">Sign in</rfg-button>

  <p class="auth-help">
    No account? Accounts are created by a SkillRx administrator.
    <a href="mailto:contact@skillrx.org">Contact us</a>
  </p>
<% end %>
