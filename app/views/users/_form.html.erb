<%= form_with(model: user, html: { class: "surface", novalidate: true }) do |form| %>
  <div class="form-card">
    <%= render "shared/errors", errors: user.errors.full_messages, resource_name: "user" %>

    <%= form_field form, :email, label: "Email address", required: true do %>
      <%= form.email_field :email, autocomplete: "off", class: "form-input" %>
    <% end %>

    <% if user.persisted? %>
      <%= form_field form, :password, label: "New password", optional: true, hint: "Leave blank to keep their current password." do %>
        <%= form.password_field :password, autocomplete: "new-password", class: "form-input" %>
      <% end %>
    <% else %>
      <%= form_field form, :password, label: "Password", required: true, hint: "At least 8 characters. Share it with them securely; they can change it from the sign-in page." do %>
        <%= form.password_field :password, autocomplete: "new-password", class: "form-input" %>
      <% end %>
    <% end %>

    <div class="checkbox-field">
      <%= form.check_box :is_admin, aria: { describedby: "user_is_admin_hint" } %>
      <div>
        <%= form.label :is_admin, "Administrator" %>
        <p id="user_is_admin_hint" class="form-help-text m-0">Can see every provider's topics, beacons and the administration pages, including users.</p>
      </div>
    </div>

    <%# Existing providers only: allow-new was true, which let someone type a name that was then
        submitted as a provider id and failed. %>
    <div data-controller="select-tags">
      <%= form_field form, :provider_ids, label: "Providers", optional: true, hint: "The providers whose topics this person can see and edit." do %>
        <%= form.select :provider_ids, options_from_collection_for_select(Provider.order(:name), :id, :name, user.providers.ids),
              { include_blank: false }, multiple: true, placeholder: "Choose providers",
              data: { "allow-new": "false", "allow-clear": "true", "select-tags-target": "tagList" } %>
      <% end %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit user.persisted? ? "Save user" : "Add user", class: "button button-primary" %>
    <%= link_to "Cancel", user.persisted? ? user_path(user) : users_path, class: "button button-ghost" %>
  </div>
<% end %>
