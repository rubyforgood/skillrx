<% content_for :title, "Users" %>

<div class="page">
  <%= render "shared/page_header", title: "Users" do %>
    <%= link_to "Add a user", new_user_path, class: "button button-primary" %>
  <% end %>

  <%= form_for :search, url: users_path, method: :get, html: { role: "search", "aria-label": "Users" },
        data: { controller: "search", search_target: "search", turbo_frame: "user-list", turbo_action: "advance" } do |f| %>
    <% current = (params[:search]&.permit(:email, :is_admin, :order)&.to_h || {}).with_indifferent_access %>
    <rfg-filter-bar>
      <div slot="search">
        <%= f.label :email, "Search", class: "form-label" %>
        <%= f.search_field :email, value: current[:email], placeholder: "Email address", class: "form-input", data: { action: "input->search#submit" } %>
      </div>
      <div slot="fields">
        <%= f.label :is_admin, "Role", class: "form-label" %>
        <%= f.select :is_admin, options_for_select([["Any role", ""], ["Admin", "true"], ["Contributor", "false"]], current[:is_admin].to_s),
              {}, class: "form-select", data: { action: "change->search#submit" } %>
      </div>
      <%# Sort isn't a filter: at the row's end, kept by Clear filters (docs/design/decisions.md, 2026-11-26). %>
      <button slot="actions" type="submit" name="clear" value="1" class="button button-ghost" data-turbo-frame="_top">Clear filters</button>
      <div slot="end" class="w-40">
        <%= f.label :order, "Sort", class: "form-label" %>
        <%= f.select :order, options_for_select([["Newest first", "desc"], ["Oldest first", "asc"]], current[:order].to_s),
              {}, class: "form-select", data: { action: "change->search#submit" } %>
      </div>
    </rfg-filter-bar>
  <% end %>

  <%= render "user_list" %>
</div>
