<% content_for :title, @user.email %>

<div class="page">
  <%= render "shared/page_header", title: @user.email, subtitle: @user.is_admin? ? "Administrator" : "Contributor" do %>
    <%= link_to "Edit", edit_user_path(@user), class: "button button-primary" %>
    <% if Current.user.is_admin? && Current.user != @user %>
      <%= button_to "Delete", @user, method: :delete, class: "button button-ghost text-danger", form_class: "contents",
            data: { turbo_confirm: "Delete #{@user.email}? They won't be able to sign in. This can't be undone.", confirm_button: "Delete user" } %>
    <% end %>
  <% end %>
  <p class="back-link"><%= link_to "Back to users", users_path %></p>

  <div class="grid-2" id="<%= dom_id @user %>">
    <section class="surface" aria-labelledby="user-access">
      <div class="surface-head"><h2 id="user-access">Access</h2></div>
      <div class="surface-body">
        <dl class="details">
          <dt>Role</dt>
          <dd><%= @user.is_admin? ? "Administrator: every provider, plus the administration pages" : "Contributor: topics for their providers" %></dd>
          <dt>Providers</dt>
          <dd>
            <% if @user.providers.any? %>
              <ul class="chips"><% @user.providers.each do |provider| %><li class="chip"><%= link_to provider.name, provider_path(provider) %></li><% end %></ul>
            <% elsif @user.is_admin? %>All, as an administrator
            <% else %><span class="muted">None. They can't see any topics until one is added.</span><% end %>
          </dd>
        </dl>
      </div>
    </section>

    <section class="surface" aria-labelledby="user-record">
      <div class="surface-head"><h2 id="user-record">Record</h2></div>
      <div class="surface-body">
        <dl class="details details--stacked">
          <dt>Added</dt><dd><%= @user.created_at.strftime("%b %-d, %Y at %-l:%M %p") %></dd>
          <dt>Last updated</dt><dd><%= @user.updated_at.strftime("%b %-d, %Y at %-l:%M %p") %></dd>
          <dt>ID</dt><dd><%= @user.id %></dd>
        </dl>
      </div>
    </section>
  </div>
</div>
