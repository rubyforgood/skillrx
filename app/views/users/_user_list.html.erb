<%= turbo_frame_tag "user-list" do %>
  <div class="surface">
    <rfg-table>
      <table class="data-table">
        <caption class="sr-only">Users</caption>
        <thead>
          <tr>
            <th scope="col">User</th>
            <th scope="col">Role</th>
            <th scope="col">Providers</th>
            <th scope="col">Added</th>
            <th scope="col" class="actions-col"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <th scope="row">
                <span class="row-person">
                  <rfg-avatar name="<%= user.email %>" size="sm"></rfg-avatar>
                  <%= link_to user.email, user, class: "row-title", data: { turbo_frame: "_top" } %>
                </span>
              </th>
              <td><rfg-status-pill tone="<%= user.is_admin? ? "brand" : "neutral" %>"><%= user.is_admin? ? "Administrator" : "Contributor" %></rfg-status-pill></td>
              <td>
                <% if user.providers.any? %>
                  <ul class="chips"><% user.providers.each do |provider| %><li class="chip"><%= provider.name %></li><% end %></ul>
                <% elsif user.is_admin? %>All<% else %><span class="muted">None</span><% end %>
              </td>
              <td class="whitespace-nowrap"><%= user.created_at.strftime("%b %-d, %Y") %></td>
              <td class="actions-col">
                <%= link_to "Edit", edit_user_path(user), class: "button button-ghost button-sm", aria: { label: "Edit #{user.email}" }, data: { turbo_frame: "_top" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </rfg-table>
    <% if @users.none? %>
      <div class="empty"><p class="empty-title">No users match</p><p>Try another search, or <%= link_to "clear it", users_path, data: { turbo_frame: "_top" } %>.</p></div>
    <% end %>
    <div class="table-foot">
      <p class="table-count"><% if @pagy.count.zero? %>No users<% else %>Showing <strong><%= @pagy.from %>–<%= @pagy.to %></strong> of <strong><%= @pagy.count %></strong> <%= "user".pluralize(@pagy.count) %><% end %></p>
      <%= render "shared/pagination", pagy: @pagy %>
    </div>
  </div>
<% end %>
