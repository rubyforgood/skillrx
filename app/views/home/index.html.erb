<%# Plain links, not <rfg-button href>: that only becomes a link once JavaScript runs, and the
    public page's two main actions should work without it. %>
<%# The public home page (option A, decided 2026-11-24: today's sections, restyled). The numbers
    section and the subject module counts were removed because nobody could confirm them; see
    docs/design/decisions.md for how to restore them. %>
<header class="site-head" data-controller="disclosure">
  <div class="site-wrap site-head-row">
    <%= link_to root_path, class: "site-logo" do %>
      <%= image_tag("skill.svg", alt: "SkillRx home") %>
    <% end %>

    <nav class="site-nav" aria-label="Main">
      <a href="#about">About</a>
      <a href="#features">Features</a>
      <a href="#contact">Contact</a>
    </nav>

    <div class="site-account">
      <% if authenticated? %>
        <%= link_to "Dashboard", topics_path, class: "site-nav-link" %>
        <%= button_to "Sign out", session_path, method: :delete, class: "site-button-secondary", form_class: "contents" %>
      <% else %>
        <%= link_to "Sign in", new_session_path, class: "site-button-primary", id: "desktop-sign-in" %>
      <% end %>
      <button type="button" class="site-menu-button" aria-label="Menu" aria-expanded="false" aria-controls="site-menu"
              data-disclosure-target="button" data-action="disclosure#toggle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>

  <nav id="site-menu" class="site-menu" aria-label="Main" data-disclosure-target="panel" hidden>
    <a href="#about" data-action="disclosure#close">About</a>
    <a href="#features" data-action="disclosure#close">Features</a>
    <a href="#contact" data-action="disclosure#close">Contact</a>
  </nav>
</header>

<main id="main-content" tabindex="-1">
  <section class="site-hero" aria-labelledby="hero-heading">
    <div class="site-wrap site-hero-row">
      <div>
        <h1 id="hero-heading">Medical education without borders</h1>
        <p>Empowering healthcare professionals worldwide with accessible, offline-first continuing medical education.</p>
        <div class="site-ctas">
          <a class="site-button-light" href="mailto:contact@skillrx.org">Contact us</a>
          <a class="site-button-outline" href="#features">Learn more</a>
        </div>
      </div>

      <%# An illustration of what a topic looks like, not real data, so hidden from screen readers. %>
      <div class="site-hero-card" aria-hidden="true">
        <div>
          <div class="site-hero-card-title">Hand hygiene in the clinic</div>
          <div class="site-hero-card-meta">Spanish</div>
        </div>
        <div class="site-hero-doc">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8z"/><path d="M14 3v5h5"/></svg>
          <div><div class="site-hero-card-title">Handwashing steps.pdf</div><div class="site-hero-card-meta">Available offline</div></div>
        </div>
        <div class="site-hero-doc">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
          <div><div class="site-hero-card-title">Audio guide.mp3</div><div class="site-hero-card-meta">Available offline</div></div>
        </div>
      </div>
    </div>
  </section>

  <section id="features" class="site-band" aria-labelledby="features-heading">
    <div class="site-wrap">
      <h2 id="features-heading">Revolutionizing medical education</h2>
      <p class="site-sub">Discover how SkillRx transforms the way healthcare professionals learn and grow.</p>
      <div class="site-grid-3">
        <div class="site-feature">
          <div class="site-feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M17.5 19a4.5 4.5 0 1 0-1.4-8.8A6 6 0 1 0 6 16.5"/><path d="m3 3 18 18"/></svg></div>
          <h3>Offline-first access</h3>
          <p>Access comprehensive medical education content anytime, anywhere, with no internet connection required. Made for remote locations.</p>
        </div>
        <div class="site-feature">
          <div class="site-feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8M21 3v5h-5"/></svg></div>
          <h3>Smart synchronization</h3>
          <p>Automatically sync your progress and download the latest content when connected, for a seamless experience across devices.</p>
        </div>
        <div class="site-feature">
          <div class="site-feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6v6H9z"/></svg></div>
          <h3>Multi-platform ready</h3>
          <p>Deploy on USB drives, mobile apps or local servers. Flexible options that adapt to your infrastructure and needs.</p>
        </div>
      </div>
    </div>
  </section>

  <%# Mission (docs/design/design.md, "Home page"; decisions.md, 2026-11-27): the mission as one plain
      statement, three facts that don't repeat the features above (same icon tiles), and subjects as
      labels. Subjects aren't links: topics need a sign-in. The subject list and "no account needed
      to learn from a beacon" are to be confirmed by the SkillRx team. %>
  <section id="about" class="site-band site-band-alt" aria-labelledby="about-heading">
    <div class="site-wrap">
      <div class="site-mission">
        <h2 id="about-heading" class="site-label">Our mission</h2>
        <p class="site-statement">Health workers in places with little or no internet should still be able to keep their training current. SkillRx brings them continuing medical education that works offline.</p>
      </div>
      <ul class="site-facts" role="list">
        <li>
          <div class="site-feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12v8H4v-8M2 7h20v5H2zM12 22V7M12 7H7.5a2.5 2.5 0 1 1 0-5C11 2 12 7 12 7zm0 0h4.5a2.5 2.5 0 1 0 0-5C13 2 12 7 12 7z"/></svg></div>
          <div>
            <h3>Free for health workers</h3>
            <p>No fees, no subscriptions, no account needed to learn from a beacon.</p>
          </div>
        </li>
        <li>
          <div class="site-feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z"/><path d="m9 12 2 2 4-4"/></svg></div>
          <div>
            <h3>From trusted providers</h3>
            <p>Ministries of health, hospitals and NGOs publish the topics, so content comes from people who know the field.</p>
          </div>
        </li>
        <li>
          <div class="site-feature-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg></div>
          <div>
            <h3>In local languages</h3>
            <p>Each beacon carries topics in the language of the region it serves.</p>
          </div>
        </li>
      </ul>
      <div class="site-subjects">
        <h3>Subjects include</h3>
        <ul role="list">
          <li>Cardiology</li>
          <li>Emergency medicine</li>
          <li>Pharmacy</li>
          <li>Infectious diseases</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="contact" class="site-band site-contact" aria-labelledby="contact-heading">
    <div class="site-wrap">
      <h2 id="contact-heading">Ready to transform medical education?</h2>
      <p class="site-sub">Have questions, or want SkillRx where you work? We're here to help you get started.</p>
      <%# The button says what it does, like the hero's; the address is plain text beside it, so it can
          be read and copied: a mailto: link does nothing on a computer with no mail app set up. %>
      <div class="site-contact-actions">
        <a class="site-button-primary" href="mailto:contact@skillrx.org">Contact us</a>
        <p class="site-contact-address">or email <span class="select-all">contact@skillrx.org</span></p>
      </div>
    </div>
  </section>
</main>

<footer class="site-foot">
  <div class="site-wrap site-foot-row">
    <p>© <%= Date.current.year %> SkillRx. Built by <a href="https://rubyforgood.org">Ruby For Good</a> volunteers.</p>
    <nav aria-label="SkillRx elsewhere">
      <a href="https://github.com/rubyforgood/skillrx">GitHub</a>
      <a href="https://www.linkedin.com/company/ruby-for-good">LinkedIn</a>
      <a href="mailto:contact@skillrx.org">Email</a>
    </nav>
  </div>
</footer>
