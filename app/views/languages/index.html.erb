<% content_for :title, "Languages" %>

<div class="page">
  <%= render "shared/page_header", title: "Languages" do %>
    <%= link_to "Add a language", new_language_path, class: "button button-primary", data: { turbo: false } %>
  <% end %>

  <div class="surface">
    <rfg-table>
      <table class="data-table">
        <caption class="sr-only">Languages</caption>
        <thead>
          <tr>
            <th scope="col">Language</th>
            <th scope="col">File storage folder</th>
            <th scope="col" class="actions-col"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% if @languages.any? %>
            <% @languages.each do |language| %>
              <tr>
                <th scope="row"><span class="font-semibold"><%= language.name.upcase_first %></span></th>
                <td><% if language.file_storage_prefix.present? %><code class="uid"><%= language.file_storage_prefix %></code><% else %><span class="muted">Not set</span><% end %></td>
                <td class="actions-col">
                  <%= link_to "Edit", edit_language_path(language), class: "button button-ghost button-sm", aria: { label: "Edit #{language.name.upcase_first}" } %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="3" class="empty"><p class="empty-title">No languages yet</p><p>Add one before adding topics.</p></td></tr>
          <% end %>
        </tbody>
      </table>
    </rfg-table>
  </div>
</div>
