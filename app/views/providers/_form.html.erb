<%= form_with(model: provider, local: true, html: { class: "surface", novalidate: true }) do |form| %>
  <div class="form-card">
    <%= render "shared/errors", errors: provider.errors.full_messages, resource_name: "provider" %>

    <%= form_field form, :name, label: "Name", required: true, hint: "The organization's official name." do %>
      <%= form.text_field :name, autofocus: true, class: "form-input" %>
    <% end %>

    <%= form_field form, :provider_type, label: "Type", required: true, hint: "For example, government, hospital or NGO." do %>
      <%= form.text_field :provider_type, class: "form-input" %>
    <% end %>

    <% if @provider.topics? %>
      <div id="file-name-prefix-uneditable-notice">
        <rfg-callout tone="info">This provider has topics, so their file names are set and the prefix can't change.</rfg-callout>
      </div>
      <%= form_field form, :file_name_prefix, label: "File name prefix", hint: "Added to the start of this provider's uploaded file names." do %>
        <%= form.text_field :file_name_prefix, disabled: true, value: @provider.file_name_prefix, class: "form-input" %>
      <% end %>
    <% else %>
      <%= form_field form, :file_name_prefix, label: "File name prefix", optional: true, hint: "Added to the start of this provider's uploaded file names. For example, 123_who_guidelines." do %>
        <%= form.text_field :file_name_prefix, class: "form-input" %>
      <% end %>
    <% end %>

    <div data-controller="select-tags">
      <%= form_field form, :region_ids, label: "Regions", optional: true, hint: "Where this provider's topics are used." do %>
        <%= form.collection_select :region_ids, Region.order(:name), :id, :name, { include_hidden: false }, multiple: true, placeholder: "Choose regions",
              data: { "allow-new": "false", "allow-clear": "true", "select-tags-target": "tagList" } %>
      <% end %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit provider.persisted? ? "Save provider" : "Add provider", class: "button button-primary" %>
    <%= link_to "Cancel", provider.persisted? ? provider_path(provider) : providers_path, class: "button button-ghost" %>
    <% if provider.persisted? %><span class="form-meta">Last updated <%= provider.updated_at.strftime("%b %-d, %Y") %></span><% end %>
  </div>
<% end %>
