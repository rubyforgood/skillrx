<% content_for :title, "Providers" %>

<div class="page">
  <%= render "shared/page_header", title: "Providers", subtitle: "Organizations whose topics SkillRx distributes" do %>
    <%= link_to "Add a provider", new_provider_path, class: "button button-primary", data: { turbo: false } %>
  <% end %>

  <div class="surface">
    <rfg-table>
      <table class="data-table">
        <caption class="sr-only">Providers</caption>
        <thead>
          <tr>
            <th scope="col">Provider</th>
            <th scope="col">File name prefix</th>
            <th scope="col">Regions</th>
            <th scope="col" class="actions-col"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% topic_counts = Topic.where(provider_id: @providers.map(&:id)).group(:provider_id).count %>
          <% if @providers.any? %>
            <% @providers.each do |provider| %>
              <tr>
                <th scope="row">
                  <%= link_to provider.name, provider, class: "row-title", data: { turbo: false } %>
                  <div class="row-meta"><%= provider.provider_type.presence || "No type" %></div>
                </th>
                <td><% if provider.file_name_prefix.present? %><code class="uid"><%= provider.file_name_prefix %></code><% else %><span class="muted">None</span><% end %></td>
                <td>
                  <% if provider.regions.any? %>
                    <ul class="chips"><% provider.regions.each do |region| %><li class="chip"><%= region.name %></li><% end %></ul>
                  <% else %><span class="muted">None</span><% end %>
                </td>
                <td class="actions-col">
                  <span class="row-actions">
                    <%= link_to "Edit", edit_provider_path(provider), class: "button button-ghost button-sm", aria: { label: "Edit #{provider.name}" } %>
                    <%= button_to "Delete", provider, method: :delete, class: "button button-ghost button-sm text-danger", form_class: "contents",
                          aria: { label: "Delete #{provider.name}" },
                          data: { turbo_confirm: provider_delete_warning(provider, topic_counts.fetch(provider.id, 0)), confirm_button: "Delete provider" } %>
                  </span>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="4" class="empty"><p class="empty-title">No providers yet</p><p>Add the first organization whose topics SkillRx will distribute.</p></td></tr>
          <% end %>
        </tbody>
      </table>
    </rfg-table>
  </div>
</div>
