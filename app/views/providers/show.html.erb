<% content_for :title, @provider.name %>

<div class="page">
  <%= render "shared/page_header", title: @provider.name, subtitle: @provider.provider_type.presence do %>
    <%= button_to "Delete", @provider, method: :delete, class: "button button-ghost-danger", form_class: "contents",
          data: { turbo_confirm: provider_delete_warning(@provider), confirm_button: "Delete provider" } %>
    <%= link_to "Edit", edit_provider_path(@provider), class: "button button-secondary" %>
  <% end %>
  <p class="back-link"><%= link_to "Back to providers", providers_path %></p>

  <div class="grid-2">
    <div class="stack">
      <section class="surface" aria-labelledby="provider-details">
        <div class="surface-head"><h2 id="provider-details">Details</h2></div>
        <div class="surface-body">
          <dl class="details">
            <dt>Type</dt><dd><%= @provider.provider_type.presence || "Not specified" %></dd>
            <dt>File name prefix</dt>
            <dd><% if @provider.file_name_prefix.present? %><code class="uid"><%= @provider.file_name_prefix %></code><% else %><span class="muted">None</span><% end %></dd>
            <dt>Regions</dt>
            <dd>
              <% if @provider.regions.any? %>
                <ul class="chips"><% @provider.regions.each do |region| %><li class="chip"><%= link_to region.name, region_path(region) %></li><% end %></ul>
              <% else %><span class="muted">None</span><% end %>
            </dd>
            <dt>Topics</dt><dd><%= pluralize(@provider.topics.count, "topic") %></dd>
          </dl>
        </div>
      </section>

      <section class="surface" aria-labelledby="provider-contributors">
        <div class="surface-head"><h2 id="provider-contributors">Contributors</h2><span class="muted text-sm"><%= pluralize(@provider.users.count, "person", plural: "people") %></span></div>
        <% if @provider.users.any? %>
          <ul class="people">
            <% @provider.users.each do |user| %>
              <li><rfg-avatar name="<%= user.email %>" size="sm"></rfg-avatar><%= link_to user.email, user_path(user) %></li>
            <% end %>
          </ul>
        <% else %>
          <div class="surface-body"><p class="muted m-0">None yet. To add one, edit the user and choose this provider.</p></div>
        <% end %>
      </section>
    </div>

    <section class="surface" aria-labelledby="provider-record">
      <div class="surface-head"><h2 id="provider-record">Record</h2></div>
      <div class="surface-body">
        <dl class="details details--stacked">
          <dt>Added</dt><dd><%= @provider.created_at.strftime("%b %-d, %Y") %></dd>
          <dt>Last updated</dt><dd><%= @provider.updated_at.strftime("%b %-d, %Y") %></dd>
          <dt>ID</dt><dd><%= @provider.id %></dd>
        </dl>
      </div>
    </section>
  </div>
</div>
