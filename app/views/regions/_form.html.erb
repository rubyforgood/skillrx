<%= form_with(model: region, local: true, html: { class: "surface", novalidate: true }) do |form| %>
  <div class="form-card">
    <%= render "shared/errors", errors: region.errors.full_messages, resource_name: "region" %>
    <%= form_field form, :name, label: "Name", required: true, hint: "For example, Northeast or Kisumu county." do %>
      <%= form.text_field :name, autofocus: true, class: "form-input" %>
    <% end %>
  </div>
  <div class="form-actions">
    <%= form.submit region.persisted? ? "Save region" : "Add region", class: "button button-primary" %>
    <%= link_to "Cancel", region.persisted? ? region_path(region) : regions_path, class: "button button-ghost" %>
  </div>
<% end %>
