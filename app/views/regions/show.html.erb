<% content_for :title, @region.name %>

<div class="page">
  <%= render "shared/page_header", title: @region.name do %>
    <%= button_to "Delete", @region, method: :delete, class: "button button-ghost-danger", form_class: "contents",
          data: { turbo_confirm: "Delete #{@region.name}? Its beacons are deleted too. This can't be undone.", confirm_button: "Delete region" } %>
    <%= link_to "Edit", edit_region_path(@region), class: "button button-secondary" %>
  <% end %>
  <p class="back-link"><%= link_to "Back to regions", regions_path %></p>

  <div class="grid-2">
    <section class="surface" aria-labelledby="region-providers">
      <div class="surface-head"><h2 id="region-providers">Providers</h2><span class="muted text-sm"><%= pluralize(@region.providers.count, "provider") %></span></div>
      <% if @region.providers.any? %>
        <ul class="people">
          <% @region.providers.order(:name).each do |provider| %>
            <li><%= link_to provider.name, provider_path(provider) %><span class="muted text-sm"><%= provider.provider_type %></span></li>
          <% end %>
        </ul>
      <% else %>
        <div class="surface-body"><p class="muted m-0">None yet. To add one, edit the provider and choose this region.</p></div>
      <% end %>
    </section>

    <section class="surface" aria-labelledby="region-record">
      <div class="surface-head"><h2 id="region-record">Details</h2></div>
      <div class="surface-body">
        <dl class="details details--stacked">
          <dt>Beacons</dt><dd><%= link_to pluralize(@region.beacons.count, "beacon"), beacons_path %></dd>
          <dt>Added</dt><dd><%= @region.created_at.strftime("%b %-d, %Y") %></dd>
          <dt>Last updated</dt><dd><%= @region.updated_at.strftime("%b %-d, %Y") %></dd>
        </dl>
      </div>
    </section>
  </div>
</div>
