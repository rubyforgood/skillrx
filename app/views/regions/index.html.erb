<% content_for :title, "Regions" %>

<div class="page">
  <%= render "shared/page_header", title: "Regions" do %>
    <%= link_to "Add a region", new_region_path, class: "button button-primary", data: { turbo: false } %>
  <% end %>

  <div class="surface">
    <rfg-table>
      <table class="data-table">
        <caption class="sr-only">Regions</caption>
        <thead>
          <tr>
            <th scope="col">Region</th>
            <th scope="col" class="numeric">Providers</th>
            <th scope="col" class="actions-col"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% if @regions.any? %>
            <% @regions.each do |region| %>
              <tr>
                <th scope="row"><%= link_to region.name, region, class: "row-title", data: { turbo: false } %></th>
                <td class="numeric"><%= region.providers_count %></td>
                <td class="actions-col">
                  <span class="row-actions">
                    <%= link_to "Edit", edit_region_path(region), class: "button button-ghost button-sm", aria: { label: "Edit #{region.name}" } %>
                    <%= button_to "Delete", region, method: :delete, class: "button button-ghost button-sm text-danger", form_class: "contents",
                          aria: { label: "Delete #{region.name}" },
                          data: { turbo_confirm: "Delete #{region.name}? Its beacons are deleted too. This can't be undone.", confirm_button: "Delete region" } %>
                  </span>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="3" class="empty"><p class="empty-title">No regions yet</p><p>Add a region before provisioning beacons.</p></td></tr>
          <% end %>
        </tbody>
      </table>
    </rfg-table>
  </div>
</div>
