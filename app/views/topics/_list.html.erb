<%# Row actions (docs/design/design.md, "Row actions"): the title links to the topic, and Edit is
    the one button. Archive and delete are on the topic's page. A table whose rows can reach three
    actions, or whose actions vary by state or role, uses a ⋯ menu on every row instead. %>
<tbody>
  <% topics.each do |topic| %>
    <tr>
      <th scope="row">
        <%= link_to topic.title, topic_path(topic, search: search_params), class: "row-title", data: { turbo: false } %>
        <div class="row-meta">Published <%= topic.published_at&.strftime("%b %-d, %Y") %></div>
      </th>
      <% if all_providers? %><td class="whitespace-nowrap"><%= topic.provider.name %></td><% end %>
      <td>
        <% if topic.description.present? %>
          <span class="clamp-2"><%= topic.description %></span>
        <% else %>
          <span class="text-neutral-500">No description</span>
        <% end %>
      </td>
      <td><%= topic.language.name.upcase_first %></td>
      <td class="uid"><% if topic.uid.present? %><span title="<%= topic.uid %>"><%= truncate(topic.uid, length: 9, omission: "…") %></span><% else %>—<% end %></td>
      <td class="numeric"><%= topic.documents.size %></td>
      <td>
        <rfg-status-pill tone="<%= topic.active? ? "success" : "neutral" %>"><%= topic.active? ? "Active" : "Archived" %></rfg-status-pill>
      </td>
      <td class="actions-col">
        <%= link_to "Edit", edit_topic_path(topic), class: "button button-ghost button-sm",
                    aria: { label: "Edit #{topic.title}" }, data: { testid: topic.id, turbo: false } %>
      </td>
    </tr>
  <% end %>
</tbody>
