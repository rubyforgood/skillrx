<%# The topic form (docs/design/design.md, "Forms"): one column of fields in sections, required
    fields marked, each field's hint and error wired to it, and the actions at the bottom. %>
<%# The upload controller is on the form: its targets include the Save button in the actions bar. %>
<%= form_for topic, html: { class: "surface", novalidate: true, data: { controller: "upload", upload_topic_id_value: topic.id } } do |f| %>
  <div class="form-card">
    <%= render "shared/errors", errors: errors.presence || [], resource_name: "topic" %>

    <section class="form-section" aria-labelledby="topic-details-heading">
      <h2 id="topic-details-heading">Details</h2>

      <%= form_field f, :title, label: "Title", required: true do %>
        <%= f.text_field :title, class: "form-input" %>
      <% end %>

      <%= form_field f, :description, label: "Description", optional: true do %>
        <%= f.text_area :description, rows: 4, class: "form-textarea" %>
      <% end %>

      <div class="form-grid">
        <% if Current.user.is_admin? %>
          <%= form_field f, :provider_id, label: "Provider", required: true do %>
            <%= f.collection_select :provider_id, Provider.order(:name), :id, :name, { prompt: "Choose a provider" }, class: "form-select" %>
          <% end %>
        <% end %>

        <%= form_field f, :language_id, label: "Language", required: true do %>
          <%= f.collection_select :language_id, Language.order(:name), :id, ->(l) { l.name.upcase_first },
                { selected: topic.language&.id || Language.first&.id }, class: "form-select" %>
        <% end %>

        <%= form_field f, :published_at_year, label: "Year published", required: true do %>
          <%= f.select :published_at_year, options_for_select((2016..Date.today.year).to_a.reverse.map(&:to_s), (topic.published_at_year || Date.today.year).to_s),
                {}, class: "form-select" %>
        <% end %>

        <%= form_field f, :published_at_month, label: "Month published", required: true do %>
          <%= f.select :published_at_month, options_for_select((1..12).map { |m| [Date::MONTHNAMES[m], m.to_s] }, (topic.published_at_month || Date.today.month).to_s),
                {}, class: "form-select" %>
        <% end %>
      </div>

      <div data-controller="select-tags">
        <%= form_field f, :tag_list, label: "Tags", optional: true, for_id: "topic_tag_list",
              hint: "Type to find a tag, or press Enter to add a new one.#{" Adding or removing a tag also adds or removes its cognates." if topic.persisted?}" do %>
          <%= f.select :tag_list,
                options_from_collection_for_select(ActsAsTaggableOn::Tag.order(name: :asc), :name, :name, topic.tag_list),
                { include_blank: true }, multiple: true, placeholder: "Add tags",
                data: { "allow-new": "true", "allow-clear": "true", "select-tags-target": "tagList" } %>
        <% end %>
      </div>
    </section>

    <section class="form-section" aria-labelledby="topic-documents-heading">
      <h2 id="topic-documents-heading">Documents</h2>

      <ul class="documents" data-upload-target="filesContainer">
        <% if topic.documents_blobs.present? %>
          <%= render partial: "topics/document_list", locals: { blobs: topic.documents_blobs, hidden_input: false } %>
        <% end %>
      </ul>

      <% topic.documents.each do |document| %>
        <%= f.hidden_field :documents, multiple: true, value: document.signed_id, data: { upload_target: "hiddenField" } %>
      <% end %>

      <label for="documents" class="dropzone">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 16V4m0 0-4 4m4-4 4 4M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg>
        <span class="dropzone-action">Choose files to upload</span>
        <span class="dropzone-hint" id="documents_hint">PDF, image or audio files</span>
        <%= f.file_field :documents, multiple: true, class: "sr-only", id: "documents", accept: Topic::CONTENT_TYPES.join(","),
              aria: { describedby: "documents_hint" }, data: { upload_target: "filesInput", action: "change->upload#uploadFile" } %>
      </label>
    </section>
  </div>

  <div class="form-actions">
    <%= f.submit "Save topic", class: "button button-primary", data: { upload_target: "submitButton" } %>
    <%= link_to "Cancel", topic.persisted? ? topic_path(topic) : topics_path, class: "button button-ghost" %>
    <% if topic.persisted? %>
      <span class="form-meta">Last updated <%= topic.updated_at.strftime("%b %-d, %Y at %-l:%M %p") %></span>
    <% end %>
  </div>
<% end %>
