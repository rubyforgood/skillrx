<div class="grid-2">
  <div class="stack">
    <section class="surface" aria-labelledby="topic-about">
      <div class="surface-head"><h2 id="topic-about">About this topic</h2>
        <rfg-status-pill tone="<%= @topic.archived? ? "neutral" : "success" %>"><%= @topic.archived? ? "Archived" : "Active" %></rfg-status-pill></div>
      <div class="surface-body">
        <% if @topic.description.present? %>
          <div class="prose-text"><%= @topic.description %></div>
        <% else %>
          <p class="muted m-0">No description.</p>
        <% end %>
      </div>
    </section>

    <section class="surface" aria-labelledby="topic-documents">
      <div class="surface-head"><h2 id="topic-documents">Documents</h2><span class="muted text-sm"><%= pluralize(@topic.documents.size, "file") %></span></div>
      <% if @topic.documents.any? %>
        <ul class="documents documents--list">
          <% @topic.documents.each do |document| %>
            <li class="document">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8z"/><path d="M14 3v5h5"/></svg>
              <%= link_to document.filename, rails_blob_path(document, disposition: "inline"), class: "document-name" %>
              <span class="muted text-sm"><%= number_to_human_size(document.byte_size) %></span>
              <%= link_to "Download", rails_blob_path(document, disposition: "attachment"), class: "button button-ghost button-sm",
                    aria: { label: "Download #{document.filename}" } %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="surface-body"><p class="muted m-0">No documents yet. <%= link_to "Add some", edit_topic_path(@topic) %>.</p></div>
      <% end %>
    </section>
  </div>

  <section class="surface" aria-labelledby="topic-facts">
    <div class="surface-head"><h2 id="topic-facts">Details</h2></div>
    <div class="surface-body">
      <dl class="details details--stacked">
        <dt>Language</dt><dd><%= @topic.language&.name&.upcase_first || "—" %></dd>
        <dt>Provider</dt><dd><%= @topic.provider&.name || "—" %></dd>
        <dt>Published</dt><dd><%= @topic.published_at&.strftime("%B %Y") || "—" %></dd>
        <dt>UID</dt><dd class="font-mono text-sm break-all"><%= @topic.uid.presence || "—" %></dd>
        <dt>Tags</dt>
        <dd>
          <% if @topic.tags.any? %>
            <ul class="chips"><% @topic.tags.each do |tag| %><li class="chip"><%= tag.name %></li><% end %></ul>
          <% else %>
            <span class="muted">None</span>
          <% end %>
        </dd>
        <dt>Added</dt><dd><%= @topic.created_at.strftime("%b %-d, %Y") %></dd>
        <dt>Last updated</dt><dd><%= @topic.updated_at.strftime("%b %-d, %Y") %></dd>
      </dl>
    </div>
  </section>
</div>
