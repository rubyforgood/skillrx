<%# `params` here is the controller's search_params, already unwrapped from params[:search]. It
    used to be read as params.dig(:search, …), which is always nil, so every filter showed its blank
    option even on a filtered list. Values are compared as strings, because the URL's are.

    State's first option is Active, because with no filters the list shows active topics only
    (search_params defaults to state: active). "Any state" (blank) shows both. %>
<% current = params.to_h.with_indifferent_access %>
<%# Search stays visible; the other filters fold behind "Filters", which starts open when any of
    them is set (<rfg-filter-bar>, design system 0.1.5). The form wraps the bar, so the controls
    keep submitting into the topic list's Turbo frame as they did. %>
<%= form_for :search, url: topics_path, method: :get, html: { role: "search", "aria-label": "Topics" },
      data: { controller: "topics", topics_target: "searchForm", turbo_frame: "topic-list", turbo_action: "advance" } do |f| %>
  <rfg-filter-bar>
    <div slot="search">
      <%= f.label :query, "Search", class: "form-label" %>
      <%= f.search_field :query, value: current[:query].to_s, placeholder: "Title, description or UID",
            class: "form-input", data: { action: "input->topics#searchTopics" } %>
    </div>

    <div slot="fields">
      <%= f.label :language_id, "Language", class: "form-label" %>
      <%= f.select :language_id, options_from_collection_for_select(languages, :id, ->(l) { l.name.upcase_first }, current[:language_id].to_s),
            { prompt: "Any language" }, class: "form-select", data: { action: "change->topics#searchTopics" } %>
    </div>

    <div slot="fields" data-controller="select-tags">
      <%= f.label :tag_list, "Tags", class: "form-label", for: "search_tag_list" %>
      <%= f.select :tag_list, options_for_select(Tag.order(:name).pluck(:name), Array(current[:tag_list])),
            { include_hidden: false }, multiple: true, id: "search_tag_list", placeholder: "Any tag",
            data: { "select-tags-target": "tagList", "allow-clear": "true", "allow-new": "false", action: "change->topics#searchTopics" } %>
    </div>

    <div slot="fields">
      <%= f.label :year, "Year published", class: "form-label" %>
      <%= f.select :year, options_for_select((Date.today.year - 10..Date.today.year).map(&:to_s).reverse, current[:year].to_s),
            { prompt: "Any year" }, class: "form-select", data: { action: "change->topics#searchTopics" } %>
    </div>

    <div slot="fields">
      <%= f.label :month, "Month published", class: "form-label" %>
      <%= f.select :month, options_for_select((1..12).map { |m| [Date::MONTHNAMES[m], m.to_s] }, current[:month].to_s),
            { prompt: "Any month" }, class: "form-select", data: { action: "change->topics#searchTopics" } %>
    </div>

    <div slot="fields">
      <%= f.label :state, "State", class: "form-label" %>
      <%= f.select :state, options_for_select(Topic::STATES.map { |s| [s.to_s.capitalize, s.to_s] } + [["Any state", ""]], current[:state].to_s),
            {}, class: "form-select", data: { action: "change->topics#searchTopics" } %>
    </div>

    <div slot="fields">
      <%= f.label :order, "Sort", class: "form-label" %>
      <%= f.select :order, options_for_select([["Newest first", "desc"], ["Oldest first", "asc"]], current[:order].to_s),
            {}, class: "form-select", data: { action: "change->topics#searchTopics" } %>
    </div>

    <%# Plain HTML, not link_to: in development Herb wraps ERB output in a <span>, and a slotted
        element must be the filter bar's direct child. %>
    <a slot="actions" class="button button-ghost" href="<%= topics_path %>">Clear filters</a>
  </rfg-filter-bar>
<% end %>
